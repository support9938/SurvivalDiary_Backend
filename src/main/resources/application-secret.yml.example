# application-secret.yml 템플릿 — 이 파일을 application-secret.yml로 복사한 뒤 값을 채운다.
# application-secret.yml은 .gitignore에 등록되어 있어 커밋되지 않는다. 실제 값은 절대 커밋 금지.
spring:
  datasource:
    url: ${DB_URL:jdbc:mysql://localhost:3306/survival_diary?serverTimezone=Asia/Seoul&characterEncoding=UTF-8}
    username: ${DB_USERNAME:sd_user}
    password: ${DB_PASSWORD:}          # 로컬 DB 비밀번호
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    properties:
      hibernate:
        format_sql: true

logging:
  level:
    org.hibernate.SQL: debug

oauth:
  kakao:
    rest-api-key: ${KAKAO_REST_API_KEY:}
    client-secret: ${KAKAO_CLIENT_SECRET:}
  naver:
    client-id: ${NAVER_CLIENT_ID:}
    client-secret: ${NAVER_CLIENT_SECRET:}

jwt:
  secret: ${JWT_SECRET:}               # Base64 인코딩 키 (openssl rand -base64 64 로 생성)
